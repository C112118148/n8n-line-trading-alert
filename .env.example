# ==========================================
# Crypto MACD Sentinel - 環境變數設定檔範例
# ==========================================

# LINE Messaging API 憑證設定
# 請至 LINE Developers Console -> Messaging API 頁籤取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_long_lived_access_token_here
LINE_TARGET_USER_ID=your_line_user_or_group_id_here

# 監控策略與標的設定
MONITORED_MARKETS=btctwd,ethtwd,dogetwd,shibtwd
KLINE_PERIOD_MINUTES=30
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9